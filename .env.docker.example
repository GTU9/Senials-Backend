# ── 서버 ──────────────────────────────────────────────────────────────────────
SERVER_PORT=8081

# ── 데이터베이스 ───────────────────────────────────────────────────────────────
# 예) jdbc:mysql://db.example.com:3306/senialsDB?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# 32자 이상 랜덤 문자열 권장
JWT_SECRET=

# ── 업로드 경로 (컨테이너 내부 경로, 변경 불필요) ─────────────────────────────
UPLOAD_PATH=/app/uploads

# ── CORS ──────────────────────────────────────────────────────────────────────
# 예) http://123.456.789.0  또는  https://yourdomain.com
CORS_ORIGIN=
